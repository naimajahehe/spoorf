# ==========================================
# NetCut Sentinel (Spoorf) — Git Ignore Rules
# ==========================================

# 1. Environment Variables & Local Secrets
.env
.env.*
*.env
*.env.*
# Negasi HARUS terakhir: aturan gitignore, pattern pencocokan TERAKHIR yang menang.
# Sebelumnya `!.env.example` mendahului `*.env.*` sehingga template tetap ter-ignore.
!.env.example

# 2. TLS Certificates & Private Keys (Generated dynamically at runtime)
certs/
**/certs/*.pem
**/certs/*.crt
**/certs/*.key
*.pem
*.crt
*.key
*.p12
*.pfx

# 3. Dependencies & Package Managers
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-store/

# 4. Logs, Diagnostics & Crash Dumps
*.log
logs/
**/logs/
*.dmp
*.dump
core.*
heapdump-*.heapsnapshot

# 5. Python Virtual Environments, Wheels & Bytecode Caches
venv/
**/venv/
.venv/
**/__pycache__/
*.py[cod]
*$py.class
*.so
*.whl
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
pip-wheel-metadata/

# 6. Compiled Outputs, Binaries & Installers
dist/
**/dist/
python-service/build/
dist-installer/
**/dist-installer/
dist-test/
**/dist-test/
spoorf-engine/
**/spoorf-engine/
win-unpacked/
**/*-unpacked/
*.egg-info/
.eggs/
*.exe
*.msi
*.dll

# Electron installer configuration & build templates
!desktop-electron/build/
!desktop-electron/build/**

# 7. Runtime SQLite Database & WAL Logs
data/
**/data/*.db
**/data/*.db-wal
**/data/*.db-shm
**/data/*.sqlite
**/data/*.sqlite3
**/data/targets.json
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*-journal
*.journal

# 8. Build Caches & Tooling Artifacts
*.tsbuildinfo
.eslintcache
vite.config.ts.timestamp-*
.turbo/
.cache/

# 9. IDE & OS Generated Files
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.swp
*.swo
*~
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# 10. Graphify Artifacts & Transient Data
graphify-out/
**/graphify-out/
.graphify*
