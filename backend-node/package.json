{
  "name": "netcut-backend",
  "version": "1.0.0",
  "description": "NetCut Clone Backend Orchestrator",
  "main": "dist/app.js",
  "scripts": {
    "dev": "ts-node-dev --respawn src/app.ts",
    "build": "tsc",
    "start": "node dist/app.js",
    "test": "ts-node tests/run_tests.ts",
    "spec:list": "ts-node -e \"console.log(require('fs').readFileSync('../docs/specs/README.md', 'utf8'))\"",
    "spec:troubleshoot": "ts-node -e \"console.log(require('fs').readFileSync('../docs/TROUBLESHOOTING.md', 'utf8'))\""
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "better-sqlite3": "11.10.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "helmet": "^8.3.0",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "socket.io": "^4.7.2",
    "ws": "^8.21.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.14",
    "@types/express": "^4.17.21",
    "@types/node": "^20.8.0",
    "@types/ws": "^8.18.1",
    "pino-pretty": "^13.1.3",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.2.2"
  }
}
