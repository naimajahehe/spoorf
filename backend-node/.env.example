# NetCut Sentinel (Spoorf) — Backend Orchestrator config
# Salin ke `.env` lalu sesuaikan. GANTI kredensial default sebelum dipakai serius.

PORT=5000
# Bind hanya ke localhost (dashboard di PC operator). Ubah ke 0.0.0.0 hanya bila sadar risiko LAN.
HOST=127.0.0.1

# --- Keamanan (P0) ---
# Origin browser tambahan yang diizinkan (comma-separated), di luar localhost/127.0.0.1/file://
# yang sudah otomatis diizinkan. Contoh: http://localhost:5173,http://127.0.0.1:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Host tambahan yang diizinkan pada header Host (proteksi DNS-rebinding). Biasanya kosong.
# Loopback (localhost:5000, 127.0.0.1:5000) sudah otomatis diizinkan.
ALLOWED_HOSTS=
# Lisensi demo/uji: bila "true", login/aktivasi lisensi offline memberi tier berbayar
# secara longgar (berdasarkan substring email / panjang key). JANGAN aktif di produksi.
SPOORF_ALLOW_DEMO_LICENSE=false
# (deprecated) CORS_ORIGIN — dipertahankan sebagai alias ALLOWED_ORIGINS untuk kompatibilitas.
# CORS_ORIGIN=http://localhost:5173

# URL microservice Python (engine jaringan)
PYTHON_SERVICE_URL=http://127.0.0.1:8001

# --- Database ---
# Persistensi memakai SQLite (better-sqlite3, WAL) — zero-config, file data/sentinel.db.
# Override lokasi file bila perlu:
# DB_FILE=data/sentinel.db
#
# (deprecated) Konfigurasi PostgreSQL di bawah TIDAK lagi dibaca oleh kode — sisa migrasi.
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=change_me
# DB_NAME=netcut_sentinel
