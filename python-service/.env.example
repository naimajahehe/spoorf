# NetCut Sentinel Network Engine Configuration
# Salin file ini ke `.env` di direktori python-service atau root repo.

# Server Bindings
ENGINE_HOST=127.0.0.1
ENGINE_PORT=8001

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
# Logging format: text (human-readable CLI) atau json (structured JSON)
LOG_FORMAT=text

# Worker concurrency pool untuk background task (SYN scan, DNS resolve)
MAX_WORKERS=5

# Keamanan Control-Plane (P1):
# Diisi token bearer acak jika ingin mengunci control-plane secara manual.
# Pada aplikasi Electron, token di-generate secara otomatis saat startup.
SENTINEL_API_TOKEN=

# Escape-hatch dev mode: bila true (1), mengizinkan koneksi loopback tanpa token di mode dev.
# JANGAN aktifkan di produksi!
SENTINEL_ALLOW_INSECURE_DEV=1

# Allowed CORS origins tambahan (pisahkan dengan koma)
PY_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173